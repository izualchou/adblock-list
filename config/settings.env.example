# ============================================================================
# 构建参数（仓库 Settings -> Secrets and variables -> Actions 的 "Variables"）
# 本地运行也可直接导出为环境变量。脚本无第三方依赖，仅需 Python 3.8+。
# ============================================================================

# 拦截列表封顶条数，控制最终数量。
# 默认 300000（即 1000*300，作为下载产物的最大条数上限）。
# 注意：Cloudflare Gateway 单个列表上限为 Standard 1000 / Enterprise 5000 条，
#       2 MB CSV 上限。本仓库的列表是用于外部消费的「完整下载文件」，
#       若需直接上传到 Cloudflare Gateway，请改为 1000 或 5000，或自行分片。
# （变量：MAX_ENTRIES）
MAX_ENTRIES=300000

# 共识阈值：域名至少出现在几个源列表里才入选。
# 默认 1 = 全量（只要被任意一个源收录即入选，配合加权评分排序）。
# 想更保守/纯净可设 2 或 3（需被多个源共同确认）。
# （变量：MIN_SOURCES）
MIN_SOURCES=1

# 中文加成：域名每命中一个「中文专精源」(region=cn)，评分额外 +CN_BONUS。
# 默认 2.0，越大越优先中文。
# （变量：CN_BONUS）
# CN_BONUS=2.0

# 新增加成：本周期新出现（对比上一版 domains.txt）的域名，评分额外 +NEW_BONUS。
# 默认 1.0，实现「优先最近更新」。设为 0 可关闭。
# （变量：NEW_BONUS）
# NEW_BONUS=1.0

# 单源下载超时（秒）与重试
# FETCH_TIMEOUT=90
# FETCH_RETRIES=3
# FETCH_BACKOFF=5
