# ============================================================================
# 构建参数（仓库 Settings -> Secrets and variables -> Actions 的 "Variables"）
# 本地运行也可直接导出为环境变量。脚本无第三方依赖，仅需 Python 3.8+。
# ============================================================================

# 拦截列表封顶条数，控制最终数量。
# 默认 12000（实测 Cloudflare Gateway DOMAIN 列表可接受）。
# 若上传被拒，按你的计划调整：Standard 1000 / Enterprise 5000。
# （变量：MAX_ENTRIES）
MAX_ENTRIES=12000

# 共识阈值：域名至少出现在几个源列表里才入选（降低误杀）。
# 2 = 至少被 2 个源共同确认；想更激进可设 1，想更保守可设 3。
# （变量：MIN_SOURCES）
MIN_SOURCES=2

# 单源下载超时（秒）
# FETCH_TIMEOUT=30
